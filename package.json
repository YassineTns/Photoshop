{
  "name": "halftone-studio",
  "version": "1.0.0",
  "description": "Photoshop UXP plugin: non-destructive colour halftone rendering engine",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node test/run.js && node test/plugin.test.js",
    "test:engine": "node test/run.js",
    "test:plugin": "node test/plugin.test.js",
    "test:visual": "node test/run.js --visual",
    "test:heavy": "node --max-old-space-size=4096 test/run.js --heavy --visual",
    "icons": "node tools/make-icons.js",
    "playground": "node tools/build-playground.js",
    "test:layout": "node tools/build-playground.js && node test/layout.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
