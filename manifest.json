{
  "manifestVersion": 5,
  "id": "com.yassinetns.halftone.studio",
  "name": "Halftone Studio",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "halftoneStudioPanel",
      "label": {
        "default": "Halftone Studio"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 1400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 800
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 820
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-23.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light",
            "all"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "halftonePreviewPanel",
      "label": {
        "default": "Halftone Preview"
      },
      "main": "preview.html",
      "minimumSize": {
        "width": 200,
        "height": 160
      },
      "maximumSize": {
        "width": 4000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 400,
        "height": 320
      },
      "preferredFloatingSize": {
        "width": 760,
        "height": 560
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-23.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light",
            "all"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-48.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
